# Rendered by ansible. Permissions are 0400 — only the kubinate user
# can read this file. The compose service mounts it as `env_file` and
# the api binary loads it via dotenvy.

KUBINATE_ENV=prod
KUBINATE_LISTEN_ADDR=0.0.0.0:8080
KUBINATE_DATABASE_URL=postgres://{{ vault_postgres_user }}:{{ vault_postgres_password }}@postgres:5432/{{ vault_postgres_db }}
KUBINATE_REDIS_URL=redis://redis:6379
KUBINATE_ENVIRONMENT=prod

KUBINATE_KEK={{ vault_kubinate_kek }}

KUBINATE_GITHUB_CLIENT_ID={{ vault_github_client_id }}
KUBINATE_GITHUB_CLIENT_SECRET={{ vault_github_client_secret }}
KUBINATE_GITHUB_REDIRECT_URI=https://{{ ansible_host }}/v1/auth/github/callback

KUBINATE_STRIPE_SECRET_KEY={{ vault_stripe_secret_key }}
KUBINATE_STRIPE_WEBHOOK_SECRET={{ vault_stripe_webhook_secret }}

# sqlx-cli (only needed if running migrate manually inside the container)
DATABASE_URL=postgres://{{ vault_postgres_user }}:{{ vault_postgres_password }}@postgres:5432/{{ vault_postgres_db }}
