# Kubinate local-dev environment.
# Copy to `.env` and adjust as needed. Loaded by `dotenvy` when running
# `cargo run -p kubinate-api` and friends. Defaults match
# `docker-compose.yml` so the unmodified file works out of the box.
#
# Configuration precedence (lowest to highest):
#   1. Compiled defaults
#   2. config/default.toml, config/{KUBINATE_ENV}.toml
#   3. Environment variables prefixed `KUBINATE_` (nesting: `__`)
# See `crates/platform/src/config.rs`.

# --- Which config file to layer on top of defaults ---------------------------
# Picks `config/{KUBINATE_ENV}.toml`. Values: dev | staging | prod.
KUBINATE_ENV=dev

# --- AppConfig ---------------------------------------------------------------
KUBINATE_LISTEN_ADDR=0.0.0.0:8080
KUBINATE_DATABASE_URL=postgres://kubinate:kubinate@localhost:5432/kubinate
KUBINATE_REDIS_URL=redis://localhost:6379
KUBINATE_ENVIRONMENT=dev

# Optional: OTLP collector endpoint for traces. Leave unset to drop spans
# and emit structured JSON logs only.
# KUBINATE_OTLP_ENDPOINT=http://localhost:4317

# --- sqlx-cli ----------------------------------------------------------------
# `sqlx migrate run` reads DATABASE_URL directly (not the KUBINATE_ prefix).
DATABASE_URL=postgres://kubinate:kubinate@localhost:5432/kubinate

# --- tracing-subscriber ------------------------------------------------------
# See `crates/platform/src/telemetry.rs`. Default when unset: `info,sqlx=warn`.
# RUST_LOG=info,sqlx=warn,kubinate_api=debug

# --- Temporal ----------------------------------------------------------------
# Used by the workflows worker (added in Phase 1).
# TEMPORAL_ADDRESS=localhost:7233

# --- Secrets / envelope encryption (ADR-0007) --------------------------------
# Base64-encoded 32 random bytes. Generate locally with:
#   openssl rand -base64 32
# In production this comes from the VPS's encrypted filesystem (ADR-0007);
# never commit a real KEK.
KUBINATE_KEK=CHANGE_ME_LOCAL_DEV_ONLY_32_BYTES_BASE64==

# --- Secrets backend selector (Sprint 4 ticket 02 partial) -------------------
# Picks between `pgcrypto` (default — uses KUBINATE_KEK above) and
# `vault` (talks to a HashiCorp Vault transit engine). The two are
# **not** simultaneously authoritative on a populated DB; flipping
# this mid-flight on existing rows fails loudly (Decrypt error) per
# the parity tests. The migration binary that re-keys rows ships in
# Sprint 5+ when the dogfood Vault deploy lands.
# KUBINATE_SECRETS_BACKEND=pgcrypto

# --- Vault (only when KUBINATE_SECRETS_BACKEND=vault) ------------------------
# Both required when the backend selector is `vault`.
# KUBINATE_VAULT_ADDR=https://vault.dogfood.kubinate.com
# KUBINATE_VAULT_TOKEN=hvs.CAESxxxxxxxxxxxxxxxxxxxxxxxx
# Transit-engine key namespace. Per-org keys land under
# `<prefix>/<organization_id>`; default `kubinate`. Different deploys
# (staging / production) sharing one Vault should set distinct
# prefixes to avoid collisions.
# KUBINATE_VAULT_KEY_PREFIX=kubinate

# --- GitHub OAuth (Sprint 1 ticket 07) ---------------------------------------
# Register a GitHub OAuth app at https://github.com/settings/developers
# Authorization callback URL must match KUBINATE_GITHUB_REDIRECT_URI exactly.
KUBINATE_GITHUB_CLIENT_ID=Iv1.xxxxxxxxxxxxxxxx
KUBINATE_GITHUB_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
KUBINATE_GITHUB_REDIRECT_URI=http://localhost:8080/v1/auth/github/callback

# --- Dev-only: bypass cookie auth via headers --------------------------------
# Set to 1 to accept X-Organization-Id (+ optional X-Actor-User-Id) as an
# actor. Useful for smoke tests and curl before the OIDC flow is wired up.
# Disable in production.
# KUBINATE_ALLOW_HEADER_ACTOR=1

# --- Cluster provisioning settings (Sprint 1 ticket 03) ----------------------
# These defaults were always in code; surfaced here so a fresh `.env`
# copies a working set without hunting through `crates/api/src/main.rs`.
#
# Hetzner SSH key resource (id or name) registered in every tenant's
# project. Sprint-1 simplification: one operator key. Defaults to
# `kubinate-operator`.
# KUBINATE_HETZNER_SSH_KEY=kubinate-operator
#
# k3s version installed by the SSH bootstrap activity. Defaults to
# `v1.30.2+k3s1`; bump in lockstep with the addon catalog
# compatibility row in `docs/addon-catalog.md` (when written).
# KUBINATE_K3S_VERSION=v1.30.2+k3s1
#
# Path to the SSH private key the OpensshExecutor uses to reach
# freshly-provisioned nodes. Optional in dev (the executor falls back
# to the agent's default keys); required for the nightly E2E harness.
# KUBINATE_SSH_KEY_PATH=/run/secrets/kubinate-ssh-key# --- Agent reverse-tunnel listener (Sprint 4 ticket 03 partial) -------------
# Sprint 4 ships the proto + the production-shaped service impl; the
# mTLS PKI that authenticates clients waits for Sprint 5+. The flag
# is the only auth gate today — flipping it on opens an UNAUTH gRPC
# port. Keep off in any environment exposed to the public internet.
#
# When set to "1": a tonic gRPC listener spawns on
# KUBINATE_AGENT_TUNNEL_ADDR (default 127.0.0.1:8081 — localhost-only
# so an operator can't accidentally publish a public unauth port).
# Anything else (including unset): no listener starts; the rest of
# the API is unaffected.
# KUBINATE_AGENT_TUNNEL_ENABLED=
# KUBINATE_AGENT_TUNNEL_ADDR=127.0.0.1:8081

# --- WebAuthn (Sprint 4 ticket 05) -------------------------------------------
# Optional: when both vars are set, `/v1/auth/passkey/*` routes are
# enabled. Either missing → routes return 503 with a Problem Details
# body explaining the deployment is not configured for WebAuthn.
# Without these the rest of the API works unchanged.
#
# RP id is the bare hostname users authenticate against (NOT a URL).
# Must match the eTLD+1 of every accepted origin.
# KUBINATE_WEBAUTHN_RP_ID=localhost
#
# Origin is the full scheme + host + port the browser presents. For
# `npm run dev` the frontend lives at :5173.
# KUBINATE_WEBAUTHN_RP_ORIGIN=http://localhost:5173
#
# RP name is the display name authenticators show during registration.
# Defaults to "Kubinate" when unset.
# KUBINATE_WEBAUTHN_RP_NAME=Kubinate

# --- Observability scrape endpoint (Sprint 3 ticket 01 defer path) -----------
# `kubinate-api` exposes `GET /metrics` in Prometheus text format
# (version 0.0.4) once the binary starts. No env var enables it; this
# entry is here so a Prometheus operator knows the route exists. The
# headline series is `kubinate_runner_workflows_inflight{kind=…}` —
# see ADR-0011 for the alerting threshold (sustained > 10 reopens
# the Temporal-SDK-adoption decision).

# --- Stripe billing (Sprint 2 ticket 08) -------------------------------------
# Both required at startup. Use Stripe test-mode keys for dev. The
# webhook secret is set on the Endpoint in the Stripe dashboard
# (Developers → Webhooks → ${URL} → Signing secret).
KUBINATE_STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
KUBINATE_STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional Checkout return URLs. Defaults point at app.kubinate.com.
# KUBINATE_BILLING_SUCCESS_URL=https://app.kubinate.com/app/settings/billing?status=success
# KUBINATE_BILLING_CANCEL_URL=https://app.kubinate.com/app/settings/billing?status=cancelled
